{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "Club 12 API - Bava"
    }
  },
  "ConnectionStrings": {
    "DbConnection": "Host=localhost; Port=5432; Database=Club12App; User Id=Club12DBA; Password=Club12App!"
  },
  "AllowedOrigins": [ "*" ],
  "JWT": {
    "Key": "!£@0#y~9I1.p0goq1£1+12345678901234567890123456789012",
    "Issuer": "club12",
    "Audience": "club12"
  }
}