**/bin/
**/obj/
**/.vs/
**/*.user
# Per-developer secrets (e.g. appsettings.Franco.json) are excluded; the
# glob also matches appsettings.Development.json, which the runtime image
# MUST still contain per the container-deployment spec, so it is
# explicitly re-included below. appsettings.json is never matched by this
# glob (it lacks the second ".") and always stays.
**/appsettings.*.json
!API/appsettings.Development.json
API.Tests/
Solution/
.git
Dockerfile
.dockerignore
